# ── Database (PostgreSQL) ─────────────────────────────────
# 개발: Neon 무료 티어  /  운영: 기존 AWS RDS
DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/dms?sslmode=require"

# ── Discord OAuth ─────────────────────────────────────────
# https://discord.com/developers/applications 에서 발급
DISCORD_CLIENT_ID=""
DISCORD_CLIENT_SECRET=""
# 이 서버의 멤버만 로그인 허용 (디스코드에서 개발자 모드 켜고 서버 우클릭 > ID 복사)
DISCORD_GUILD_ID=""

# ── Auth ──────────────────────────────────────────────────
AUTH_SECRET=""
# 배포 시 실제 접속 주소로 변경 (예: https://43-201-12-34.nip.io)
APP_URL="http://localhost:3000"

# ── AWS S3 ────────────────────────────────────────────────
AWS_REGION="ap-northeast-2"
AWS_ACCESS_KEY_ID=""
AWS_SECRET_ACCESS_KEY=""
S3_BUCKET=""

# ── Discord 업로드 알림 (선택) ────────────────────────────
DISCORD_WEBHOOK_URL=""
