generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

/// 디스코드 OAuth로 로그인한 팀원. 권한 구분 없이 전원 동등.
model User {
  id        String   @id @default(cuid())
  discordId String   @unique @map("discord_id")
  username  String
  avatarUrl String?  @map("avatar_url")
  createdAt DateTime @default(now()) @map("created_at")

  createdDocuments Document[]        @relation("DocumentCreator")
  uploadedVersions DocumentVersion[]

  @@map("users")
}

/// 자기참조 트리. parentId가 null이면 최상위 폴더.
model Folder {
  id        String   @id @default(cuid())
  name      String
  parentId  String?  @map("parent_id")
  createdAt DateTime @default(now()) @map("created_at")

  /// 업로드 자동 분류용 별칭. 파일명에 폴더 이름이 안 들어가는 경우를 위한 것이다
  /// (예: "와이어프레임" → 화면설계서). 정규화로 풀리는 표기 차이는 여기 넣지 않는다.
  aliases   String[] @default([])

  parent    Folder?    @relation("FolderTree", fields: [parentId], references: [id], onDelete: Cascade)
  children  Folder[]   @relation("FolderTree")
  documents Document[]

  @@unique([parentId, name])
  @@map("folders")
}

/// 문서의 논리적 단위. 실제 파일은 전부 DocumentVersion에 있다.
model Document {
  id          String   @id @default(cuid())
  title       String
  description String?
  folderId    String?  @map("folder_id")
  createdById String   @map("created_by")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")
  deletedAt   DateTime? @map("deleted_at")

  folder    Folder?           @relation(fields: [folderId], references: [id], onDelete: SetNull)
  createdBy User              @relation("DocumentCreator", fields: [createdById], references: [id])
  versions  DocumentVersion[]
  tags      DocumentTag[]

  @@index([folderId])
  @@index([deletedAt, updatedAt])
  @@map("documents")
}

/// 재업로드할 때마다 versionNo가 올라간다. 이전 버전의 S3 객체는 지우지 않는다.
model DocumentVersion {
  id           String   @id @default(cuid())
  documentId   String   @map("document_id")
  versionNo    Int      @map("version_no")
  s3Key        String   @map("s3_key")
  fileName     String   @map("file_name")
  mimeType     String   @map("mime_type")
  sizeBytes    Int      @map("size_bytes")
  changeNote   String?  @map("change_note")
  uploadedById String   @map("uploaded_by")
  createdAt    DateTime @default(now()) @map("created_at")

  document   Document @relation(fields: [documentId], references: [id], onDelete: Cascade)
  uploadedBy User     @relation(fields: [uploadedById], references: [id])

  @@unique([documentId, versionNo])
  /// 한 S3 객체는 한 버전만 가리킨다. 라우트의 사전 조회(check-then-act)는 동시 요청
  /// 두 발을 못 막는데, 그때 서로 다른 문서가 한 객체를 공유하면 영구삭제가 남의 파일을
  /// 지우거나(참조 수 검사가 막지만) 지울 수 없는 고아를 남긴다. 최종 방어선은 DB 다.
  @@unique([s3Key])
  @@index([documentId, versionNo(sort: Desc)])
  @@map("document_versions")
}

model Tag {
  id        String        @id @default(cuid())
  name      String        @unique
  documents DocumentTag[]

  @@map("tags")
}

model DocumentTag {
  documentId String @map("document_id")
  tagId      String @map("tag_id")

  document Document @relation(fields: [documentId], references: [id], onDelete: Cascade)
  tag      Tag      @relation(fields: [tagId], references: [id], onDelete: Cascade)

  @@id([documentId, tagId])
  @@index([tagId])
  @@map("document_tags")
}

/// 정합성 저장소(`~/orca/Nyangmeong_care`)가 보낸 측정 1회. 덮어쓰지 않고 쌓는다.
///
/// **DMS 는 계산하지 않는다.** 문서 본문을 파싱하는 것은 저쪽 일이고 이쪽은 받아서
/// 보관한다 — 서버가 html 을 읽기 시작하면 `preview.ts` 의 iframe 격리를 우회하는
/// 경로가 생기고, 파서가 두 벌이 되면 갈린다(판번호 정규식에서 실제로 겪었다).
model ConsistencySnapshot {
  id              String   @id @default(cuid())
  measuredAt      DateTime @map("measured_at")
  reqVer          String   @map("req_ver")
  errorCount      Int      @map("error_count")
  warningCount    Int      @map("warning_count")
  pendingCount    Int      @map("pending_count")
  unresolvedCount Int      @map("unresolved_count")
  createdAt       DateTime @default(now()) @map("created_at")

  metrics  ConsistencyMetric[]
  findings ConsistencyFinding[]
  docs     ConsistencySnapshotDoc[]

  /// 재전송 사고를 막는다. 측정 시각이 같으면 같은 측정이다 — 스크립트가 두 번 돌아도
  /// 두 행이 되지 않는다. 위반은 P2002 로 오고 라우트가 409 로 바꾼다.
  @@unique([measuredAt])
  @@index([measuredAt(sort: Desc)])
  @@map("consistency_snapshots")
}

/// 축별 분자/분모. **비율은 저장하지 않는다** — 어느 축이 "정합성"이냐는 판정이고
/// 그 판정은 사람이 한다. 화면에서 나눈다.
model ConsistencyMetric {
  id         String  @id @default(cuid())
  snapshotId String  @map("snapshot_id")
  axis       String
  /// axis = "reference" 일 때만 채워진다.
  fromKind   String? @map("from_kind")
  toKind     String? @map("to_kind")
  ok         Int
  total      Int

  snapshot ConsistencySnapshot @relation(fields: [snapshotId], references: [id], onDelete: Cascade)

  /// 같은 축이 두 번 들어오는 것을 막는 **보조** 수단이다. 포스트그레스는 유일 인덱스에서
  /// NULL 을 서로 다른 값으로 보므로 from/to 가 null 인 축 4개(referenceTotal·reqCoverage·
  /// reqCoverageWithDocs·scrCoverage)에는 **이 제약이 안 걸린다.** 진짜 방어는
  /// `lib/consistency.ts` 의 중복 축 검사다.
  @@unique([snapshotId, axis, fromKind, toKind])
  @@map("consistency_metrics")
}

/// 검사가 발견한 것 1건. level 은 error·warning·pending·unresolved.
model ConsistencyFinding {
  id         String  @id @default(cuid())
  snapshotId String  @map("snapshot_id")
  level      String
  check      String
  doc        String
  refId      String? @map("ref_id")
  where      String?
  message    String

  snapshot ConsistencySnapshot @relation(fields: [snapshotId], references: [id], onDelete: Cascade)

  @@index([snapshotId, level])
  @@index([snapshotId, doc])
  @@map("consistency_findings")
}

/// 이 측정에 쓴 문서와 그 판.
///
/// **`dmsId` 에 FK 를 걸지 않는다.** 문서는 하드 삭제되고(2026-09-09 통합에서 9건이
/// 사라졌다) 스냅샷은 **그 시점의 기록**이라 남아야 한다. FK 를 걸면 문서 삭제가 과거
/// 스냅샷을 깨거나 삭제 자체를 막는다. 링크는 "문서가 없으면 빼는" 쪽으로 그린다.
model ConsistencySnapshotDoc {
  id         String @id @default(cuid())
  snapshotId String @map("snapshot_id")
  key        String
  ver        String
  dmsId      String @map("dms_id")
  dmsVersion Int    @map("dms_version")

  snapshot ConsistencySnapshot @relation(fields: [snapshotId], references: [id], onDelete: Cascade)

  @@unique([snapshotId, key])
  @@map("consistency_snapshot_docs")
}
